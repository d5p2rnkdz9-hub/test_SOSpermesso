# Neon PostgreSQL: analytics (schema public), account (auth), area PRO (pro)
# Get from: Neon Console -> Project -> Connection Details -> Connection string
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Anthropic API - assistente PRO (src/lib/chat-pro.ts)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Better Auth — PRO accounts (docs/PRO-PREMIUM-PIANO.md)
# Locally NEON_DATABASE_URL should point at the Neon "dev" branch, never production.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="http://localhost:3000"

# Resend — login link emails (same key as the site). Unset in dev: the link is printed in the server log.
RESEND_API_KEY="re_..."
# RESEND_FROM="SOS Permesso <accesso@sospermesso.it>"

# Account unico con SOS Flussi (docs/PRO-PREMIUM-PIANO.md, «Account unico»)
# 1 = testi dell'account unico (email del link, pagine accedi/account, avviso prima di eliminare).
# Accendila solo quando SOS Flussi PRO è online con lo stesso schema auth.
# ACCOUNT_UNICO=1
# Lancio gratuito: ATTENZIONE, qui è ACCESO se la variabile manca (su SOS Flussi è il contrario).
# Si spegne solo con 0: da allora è PRO solo chi ha un abbonamento `pro` attivo o in prova.
# PRO_ACCESSO_LIBERO=0
# Facoltativa, stessa chiave di SOS Flussi: serve solo ad annullare l'abbonamento quando
# l'account viene eliminato da qui. Senza, chi ha un abbonamento vivo non può eliminare l'account.
# STRIPE_SECRET_KEY=

# Cloudflare Turnstile sui moduli che mandano email (src/lib/antibot.ts). Senza entrambe: spento.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
