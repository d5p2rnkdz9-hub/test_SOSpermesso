# Database - Supabase PostgreSQL
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Analytics - Neon PostgreSQL (serverless HTTP)
# Get from: Neon Console -> Project -> Connection Details -> Connection string
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Anthropic API - For Claude Haiku feedback generation
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Better Auth — PRO accounts (docs/PRO-PREMIUM-PIANO.md)
# Locally NEON_DATABASE_URL should point at the Neon "dev" branch, never production.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="http://localhost:3000"

# Resend — login link emails (same key as the site). Unset in dev: the link is printed in the server log.
RESEND_API_KEY="re_..."
# RESEND_FROM="SOS Permesso <accesso@sospermesso.it>"
